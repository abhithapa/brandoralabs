# Copy to .env for local development. Never commit real secrets.
# Required keys are marked [required]; everything else has a safe default.

# Deployment environment: development | test | staging | production.
# Production enables strict checks (real email transport, notification recipients).
APP_ENV=development

# [required] Canonical public origin. Used for metadata, sitemap and the form origin check.
SITE_URL=http://localhost:3000

# [required] PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brandora_dev

# [required] 32+ random characters. Keys rate-limit counters; generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32-xxxxxxxx

# Email delivery. `log` (development only) prints a redacted summary; `smtp` sends.
EMAIL_TRANSPORT=log
EMAIL_FROM="Brandora Labs <no-reply@example.com>"
# Required when EMAIL_TRANSPORT=smtp. Amazon SES SMTP works here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Comma-separated staff addresses that receive every submission in full.
# [required in production] Until the 1b admin ships, staff work from these emails.
LEAD_NOTIFICATION_RECIPIENTS=

# Reverse proxies in front of the app that append to X-Forwarded-For (load balancer = 1).
TRUSTED_PROXY_HOPS=1

# Display timezone for staff emails. Draft default; confirm with the business.
BUSINESS_TIMEZONE=Asia/Kathmandu

# Version label of the privacy notice shown beside the forms; stored with each submission.
PRIVACY_NOTICE_VERSION=draft-2026-10

# Set to "true" only on the production deployment to allow search indexing.
ALLOW_INDEXING=false
