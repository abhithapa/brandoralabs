// Brandora Labs — Release 1a schema.
// Staff users, internal notes and audit events arrive with Release 1b as
// additive migrations; nothing here needs to change shape for them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ServiceCategory {
  not_sure
  business_consulting
  digital_marketing
  branding_creative
  website_software_development
  ai_automation
  cloud_it_solutions
  cybersecurity
  digital_transformation
  other
}

enum ContactMethod {
  email
  phone
  whatsapp
  online_meeting
}

enum LeadStatus {
  new
  contacted
  qualified
  in_progress
  closed_won
  closed_lost
  spam
  archived
}

enum ProviderType {
  professional
  consultant
  developer
  agency
  technology_provider
  specialized_service_provider
  other
}

enum PartnerStatus {
  new
  reviewing
  approved
  declined
  archived
}

enum NotificationTarget {
  lead
  partner_application
}

enum NotificationTemplate {
  lead_acknowledgement
  lead_internal_alert
  partner_acknowledgement
  partner_internal_alert
}

enum OutboxStatus {
  pending
  sending
  sent
  failed // retries exhausted; needs staff attention
}

model Lead {
  id             String @id @default(uuid()) @db.Uuid
  publicRef      String @unique @map("public_ref") @db.VarChar(20)
  idempotencyKey String @unique @map("idempotency_key") @db.Uuid
  payloadHash    String @map("payload_hash") @db.Char(64)

  fullName      String          @map("full_name") @db.VarChar(120)
  company       String?         @db.VarChar(160)
  email         String          @db.VarChar(254)
  phone         String?         @db.VarChar(32)
  category      ServiceCategory
  description   String          @db.VarChar(5000)
  budget        String?         @db.VarChar(120)
  contactMethod ContactMethod   @default(email) @map("contact_method")

  status           LeadStatus @default(new)
  firstContactedAt DateTime?  @map("first_contacted_at") @db.Timestamptz(3)
  noticeVersion    String     @map("notice_version") @db.VarChar(40)

  // First-touch attribution (untrusted, optional)
  utmSource         String? @map("utm_source") @db.VarChar(200)
  utmMedium         String? @map("utm_medium") @db.VarChar(200)
  utmCampaign       String? @map("utm_campaign") @db.VarChar(200)
  utmTerm           String? @map("utm_term") @db.VarChar(200)
  utmContent        String? @map("utm_content") @db.VarChar(200)
  landingPath       String? @map("landing_path") @db.VarChar(300)
  referrerDomain    String? @map("referrer_domain") @db.VarChar(253)
  submittedFromPath String? @map("submitted_from_path") @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc), id])
  @@index([status, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([email])
  @@map("leads")
}

model PartnerApplication {
  id             String @id @default(uuid()) @db.Uuid
  publicRef      String @unique @map("public_ref") @db.VarChar(20)
  idempotencyKey String @unique @map("idempotency_key") @db.Uuid
  payloadHash    String @map("payload_hash") @db.Char(64)

  contactName  String            @map("contact_name") @db.VarChar(120)
  email        String            @db.VarChar(254)
  organization String?           @db.VarChar(160)
  phone        String?           @db.VarChar(32)
  providerType ProviderType      @map("provider_type")
  expertise    ServiceCategory[]
  websiteUrl   String?           @map("website_url") @db.VarChar(2048)
  capabilities String            @db.VarChar(5000)

  status        PartnerStatus @default(new)
  noticeVersion String        @map("notice_version") @db.VarChar(40)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc), id])
  @@index([status, createdAt(sort: Desc)])
  @@map("partner_applications")
}

model NotificationOutbox {
  id            String               @id @default(uuid()) @db.Uuid
  targetType    NotificationTarget   @map("target_type")
  targetId      String               @map("target_id") @db.Uuid
  template      NotificationTemplate
  recipient     String               @db.VarChar(254)
  status        OutboxStatus         @default(pending)
  attempts      Int                  @default(0)
  nextAttemptAt DateTime             @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil   DateTime?            @map("locked_until") @db.Timestamptz(3)
  lastErrorCode String?              @map("last_error_code") @db.VarChar(64)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt        DateTime?            @map("sent_at") @db.Timestamptz(3)

  @@unique([targetType, targetId, template, recipient])
  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

/// Fixed-window counters for public form and auth throttling.
/// `key` is an HMAC of scope + client address; raw IP addresses are never stored.
/// Expired rows are purged by the notification worker.
model RateLimitBucket {
  key         String   @id @db.Char(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
